# ── YojanaSetu AI Backend ── Environment Variables ──────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# Google Gemini API Key — get it free at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Conversational AI provider. Offline mode always selects local Ollama.
AI_PROVIDER=ollama
OFFLINE_MODE=true
OLLAMA_CHAT_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=gemma4:e2b
GEMINI_MODEL=gemini-1.5-flash

# Supabase credentials — get from your Supabase project dashboard
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# App settings
APP_ENV=development   # change to "production" before deploying
